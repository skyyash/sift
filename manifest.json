{
  "manifest_version": 3,
  "name": "Sift",
  "version": "0.1.0",
  "description": "Gesture-first reading for focused, commute-friendly article pacing.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/sift.js"],
      "css": ["src/content/sift.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sift",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sift@example.com",
      "strict_min_version": "109.0"
    }
  }
}
